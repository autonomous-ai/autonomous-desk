{
  "description": "Vibe Desk Display hooks",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/on-stop-done.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
